# 复制本文件为 .env 后填写真实值（.env 不会提交到 git）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=ops_kb
# Docker Compose 部署时 MySQL 容器的 root 密码（建议和上面保持一致）
MYSQL_ROOT_PASSWORD=你的MySQL密码

# 向量模型（阿里云百炼 DashScope，https://bailian.console.aliyun.com/）
DASHSCOPE_API_KEY=你的DashScope密钥
EMBEDDING_MODEL=text-embedding-v3

# 大模型（通义千问）
LLM_MODEL=qwen-plus

# Milvus 向量库
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=ops_docs

# Redis 缓存（Dify 占用 6379，本服务用 6380）
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
CACHE_TTL=3600
