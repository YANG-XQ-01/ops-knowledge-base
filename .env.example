# 复制本文件为 .env 后填写真实值（.env 不会提交到 git）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=ops_kb

# 向量模型（阿里云百炼 DashScope，https://bailian.console.aliyun.com/）
DASHSCOPE_API_KEY=你的DashScope密钥
EMBEDDING_MODEL=text-embedding-v3

# Milvus 向量库
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=ops_docs
